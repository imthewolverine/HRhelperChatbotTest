    "termsOfUseUrl": "https://github.com"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "AI Agent",
    "full": "Teams AI Agent Chat"
  },
  "description": {
    "short": "AI-powered agent chat interface",
